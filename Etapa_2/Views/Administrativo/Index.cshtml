@{
    ViewBag.Title = "Panel Administrativo";
    Layout = "~/Views/Shared/Layout_Home.cshtml"; //  layout principal
}



<section class="content">
    <div class="container-fluid">
        <!-- 🔹 Título -->
        <h1 class="mb-4">@ViewBag.Title</h1>

        <!-- 🔹 Tarjetas -->
        <div class="row">
            <!-- Mantenimientos -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h5 class="fw-normal">Mantenimientos</h5>
                        <p>Gestión de Mantenimientos</p>
                    </div>
                    <div class="icon"><i class="fas fa-tools"></i></div>
                    <a href="@Url.Action("Index", "Mantenimientos")" class="small-box-footer">
                        Ingresar <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Consultas -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h5 class="fw-normal">Consultas</h5>
                        <p>Revisión y Reportes</p>
                    </div>
                    <div class="icon"><i class="fas fa-search"></i></div>
                    <a href="@Url.Action("Index", "Consultas")" class="small-box-footer">
                        Ingresar <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Seguridad -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h5 class="fw-normal">Seguridad</h5>
                        <p>Gestión de Usuarios y Roles</p>
                    </div>
                    <div class="icon"><i class="fas fa-shield-alt"></i></div>
                    <a href="@Url.Action("Index", "Seguridad")" class="small-box-footer">
                        Ingresar <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

           
            <!-- Reportes -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h5 class="fw-normal">Reportes</h5>
                        <p>Generación de reportes</p>
                    </div>
                    <div class="icon"><i class="fas fa-file-alt"></i></div>
                    <a href="@Url.Action("Index", "Reporte")" class="small-box-footer">
                        Ingresar <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

