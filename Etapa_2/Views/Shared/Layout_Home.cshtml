<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/AdminLTE/dist/css/adminlte.min.css" />

    <!-- Font Awesome 7 (local con webfonts) -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/FontAwesome/css/all.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/DataTables/dataTables.bootstrap4.min.css" />

    <!-- Select2 -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/Select2/select2.min.css" />

    <!-- SweetAlert2 (tema Bootstrap4) -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/SweetAlert2/bootstrap-4.min.css" />

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- 🔹 Navbar superior -->
        <nav class="main-header navbar navbar-expand navbar-dark bg-dark">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Carnes La Casona
            </a>
            <ul class="navbar-nav ms-auto">
                @if (Context.Session.GetString("Usuario") != null)
                {
                    <li class="nav-item">
                        <span class="navbar-text text-white small me-3">
                            Usuario: <strong>@Context.Session.GetString("Usuario")</strong>
                        </span>
                    </li>
                    <li class="nav-item">
                        <span id="fechaHora" class="navbar-text text-white small me-3"></span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Login" asp-action="Logout">Logout</a>
                    </li>
                }
            </ul>
        </nav>

        <!-- 🔹 Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="@Url.Action("Index", "Home")" class="brand-link">
                <span class="brand-text font-weight-light">Panel de Control</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                        <li class="nav-item">
                           
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house nav-icon text-primary"></i>
                                <p>Inicio</p>
                            </a>
                           
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Administrativo" asp-action="Index">
                                <i class="fa-solid fa-briefcase nav-icon "></i>
                                <p>Administrativo</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-file-invoice-dollar nav-icon"></i>
                                <p>Gestionar Facturación</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-hand-holding-dollar nav-icon"></i>
                                <p>Gestionar Cuentas por Cobrar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-money-check-dollar nav-icon"></i>
                                <p>Gestionar Cuentas por Pagar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-building-columns nav-icon"></i>
                                <p>Gestionar Ingresos</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-chart-pie nav-icon"></i>
                                <p>Gestionar Gastos</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-book nav-icon"></i>
                                <p>Gestionar Cuentas Contables</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-percent nav-icon"></i>
                                <p>Gestionar Impuestos y Retenciones</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="fa-solid fa-sack-dollar nav-icon"></i>
                                <p>Gestionar Presupuesto</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- 🔹 Contenido principal -->
        <div class="content-wrapper">
            <section class="content pt-3">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- 🔹 Footer -->
        <footer class="main-footer text-center">
            <strong>&copy; 2026 Carnes La Casona.</strong> Todos los derechos reservados.
        </footer>
    </div>

    <!-- 🔹 Scripts locales -->
    <script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/AdminLTE/dist/js/adminlte.min.js"></script>

    <!-- DataTables -->
    <script src="~/AdminLTE/plugins/DataTables/jquery.dataTables.min.js"></script>
    <script src="~/AdminLTE/plugins/DataTables/dataTables.bootstrap4.min.js"></script>

    <!-- Chart.js -->
    <script src="~/AdminLTE/plugins/Chartjs/chart.min.js"></script>

    <!-- Select2 -->
    <script src="~/AdminLTE/plugins/Select2/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="~/AdminLTE/plugins/SweetAlert2/sweetalert2.all.min.js"></script>

    <!-- Scripts propios -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function actualizarFechaHora() {
            const ahora = new Date();
            const opciones = {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            };
            document.getElementById("fechaHora").textContent =
                ahora.toLocaleString("es-CR", opciones);
        }
        setInterval(actualizarFechaHora, 1000);
        actualizarFechaHora();
    </script>
</body>
</html>

