<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaBase</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <!-- 🔹 Navbar superior -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" asp-controller="Home" asp-action="Index">
            Carnes La Casona
        </a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button"
                data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        @if (Context.Session.GetString("Usuario") != null)
        {
            <span class="navbar-text text-white small ms-auto me-3">
                Usuario: <strong>@Context.Session.GetString("Usuario")</strong>
            </span>
            <a class="btn btn-outline-light btn-sm me-2" asp-controller="Login" asp-action="Logout">Logout</a>
        }
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- 🔹 Sidebar -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">🏠 Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Venta" asp-action="Index">💵 Ventas</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Compra" asp-action="Index">📦 Compras</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Cliente" asp-action="Index">👥 Clientes</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Reporte" asp-action="Index">📊 Reportes</a></li>
                        <li class="nav-item"><a class="nav-link text-white" asp-controller="Usuario" asp-action="Consultar_Usuarios">⚙️ Usuarios</a></li>
                    </ul>
                </div>
            </nav>

            <!-- 🔹 Contenido principal -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- 🔹 Footer -->
    <footer class="border-top footer text-muted mt-3">
        <div class="container">
            &copy; 2026 - SistemaBase - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
