@{
    Layout = "Layout_Home";
    ViewData["Title"] = "HOME";
}


    
<div class="container-fluid p-0 m-0 text-center mt-3">

    <!-- Imagen de bienvenida -->
    <img src="~/images/Banners\Carnes La Csona.png"
         alt="Carnes La Casona"
         class="img-fluid"
         style="max-height:180px; width:auto;">
</div>

    <hr class="my-4">
        <div class="mt-3">
            <a class="btn btn-danger btn-lg mx-2" href="/Ventas/Create">Registrar nueva venta</a>
            <a class="btn btn-success btn-lg mx-2" href="/Clientes/Create">Agregar cliente</a>
            <a class="btn btn-primary btn-lg mx-2" href="/Reportes">Ver reportes</a>
        </div>
    

    <!-- KPIs -->
    <div class="row text-center mt-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Ventas del día</h5>
                    <p class="card-text display-6 text-danger">₡ 250,000</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Compras recientes</h5>
                    <p class="card-text display-6 text-success">₡ 120,000</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Clientes activos</h5>
                    <p class="card-text display-6 text-primary">35</p>
                </div>
            </div>
        </div>
    </div>

